# 主 COS（默认已经指向 hi168 的 S3 兼容服务；密钥不要提交到 Git）
COS_ENDPOINT=https://s3.hi168.com
COS_BUCKET=hi168-hn5v4cadp72-j4lk05u0-s
COS_REGION=us-east-1
COS_ACCESS_KEY_ID=
COS_SECRET_ACCESS_KEY=

# 管理员登录
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 迁移来源：默认从旧墙公开 API 导入；若迁移旧 COS 则改成 s3
MIGRATION_SOURCE_TYPE=legacy_api
MIGRATION_SOURCE_API_BASE=https://tyz.l.cd

# 迁移源 COS（MIGRATION_SOURCE_TYPE=s3 时需要完整填写）
MIGRATION_SOURCE_ENDPOINT=
MIGRATION_SOURCE_BUCKET=
MIGRATION_SOURCE_REGION=us-east-1
MIGRATION_SOURCE_ACCESS_KEY_ID=
MIGRATION_SOURCE_SECRET_ACCESS_KEY=

# 留空时将源对象复制到同名路径；例如可填写 flzx/migrated
MIGRATION_TARGET_PREFIX=

# 单个图片/视频最大大小，默认 512 MB
MEDIA_MAX_BYTES=536870912
